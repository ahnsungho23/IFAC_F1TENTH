+  P3ShadowCandidateTrace oracleCandidate(
+    const EgoFrenetState & ego,
+    const std::vector<f110_msgs::msg::Obstacle> & obstacles,
+    bool go_left,
+    double d_target,
+    double d_mid,
+    double entry_scale,
+    double exit_scale,
+    bool relaxed_clearance_gate) const
+  {
+    const P3ShadowPlanningContext context = planner_.buildP3ShadowPlanningContext(
+      ego, obstacles, relaxed_clearance_gate);
+    if (!context.valid) {
+      throw std::runtime_error("oracle context unavailable: " + context.reason);
+    }
+    const P3ShadowSideDomain & domain = go_left ? context.left : context.right;
+    if (!domain.valid) {
+      throw std::runtime_error("oracle side unavailable: " + domain.reason);
+    }
+    cycle_cluster_ids_ = context.cluster_ids;
+    const auto stations = stationsFor(
+      parameters_, domain, context.outside_is_left, entry_scale, exit_scale,
+      ego.d, d_target, referenceSpacing());
+    double reconstruction_us = 0.0;
+    double validation_us = 0.0;
+    P3ShadowCandidateTrace trace;
+    try {
+      trace = buildCandidate(
+        ego, obstacles, go_left, context.outside_is_left, d_target, d_mid,
+        entry_scale, exit_scale, stations, 0U, reconstruction_us, validation_us);
+    } catch (const std::runtime_error & error) {
+      if (std::string(error.what()) != "non-positive quintic-Hermite segment") {
+        throw;
+      }
+      trace.go_left = go_left;
+      trace.d_target = d_target;
+      trace.d_mid = d_mid;
+      trace.entry_scale = entry_scale;
+      trace.exit_scale = exit_scale;
+      trace.knot_stations = stations;
+      trace.rejection_reason = error.what();
+    }
+    if (!trace.path.wpnts.empty()) {
+      const auto waypoint0 = planner_.measureFootprintTrackBound(trace.path.wpnts.front(), 0U);
+      trace.waypoint0_s_m = waypoint0.waypoint_s_m;
+      trace.waypoint0_d_m = trace.path.wpnts.front().d_m;
+      trace.waypoint0_x_m = waypoint0.waypoint_x_m;
+      trace.waypoint0_y_m = waypoint0.waypoint_y_m;
+      trace.waypoint0_yaw_rad = waypoint0.waypoint_yaw_rad;
+      trace.waypoint0_center_track_margin_m = waypoint0.centerline_clearance_m;
+      trace.waypoint0_footprint_track_margin_m = waypoint0.footprint_clearance_m;
+      trace.waypoint0_footprint_invalid = waypoint0.invalid;
+    }
+    trace.generator_stage = "ORACLE_GRID";
+    trace.candidate_template = "FROZEN_P3_FAMILY";
+    trace.mapping_source = "AUDIT_ONLY_DETERMINISTIC_ORACLE";
+    trace.source_cell = relaxed_clearance_gate ? "RELAXED_DOMAIN" : "STRICT_DOMAIN";
+    return trace;
+  }
