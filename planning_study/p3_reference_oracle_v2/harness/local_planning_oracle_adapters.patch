+  bool go_left,
+  double d_target,
+  double d_mid,
+  double entry_scale,
+  double exit_scale,
+  bool relaxed_clearance_gate) const
+{
+  return P3ShadowEvaluator(*this).oracleCandidate(
+    ego, obstacles, go_left, d_target, d_mid, entry_scale, exit_scale,
+    relaxed_clearance_gate);
