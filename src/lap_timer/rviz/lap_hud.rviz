          Value: true
        ego_racecar/front_left_wheel:
          Value: true
        ego_racecar/front_right_hinge:
          Value: true
        ego_racecar/front_right_wheel:
          Value: true
        ego_racecar/laser:
          Value: true
        ego_racecar/laser_model:
