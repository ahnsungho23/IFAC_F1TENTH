<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>opponent_simulator</name>
  <version>0.1.0</version>
  <description>Centerline-following opponent vehicle controller for two-agent F1TENTH simulation.</description>
  <maintainer email="myungsub@example.com">myungsub</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>f110_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
