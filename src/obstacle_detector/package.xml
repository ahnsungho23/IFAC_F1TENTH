<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>obstacle_detector</name>
  <version>0.0.1</version>
  <description>LiDAR-only layered obstacle detection for F1TENTH racing.
    obstacle_detector_node clusters the 2D LiDAR scan, safely rejoins fragmented surfaces,
    removes walls with the known /map (Layer 1), projects complete Cartesian AABBs into
    authoritative raceline Frenet bounds, and tracks them with adaptive measurement covariance
    and gated one-to-one association. It preserves matching visible map-frame Cartesian AABBs and
    publishes stationary obstacles on
    /static_obs (Layer 2) and the nearest moving opponent on /opp_obs (Layer 3).</description>
  <maintainer email="parkm04@hanyang.ac.kr">parkm04</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>f110_msgs</depend>
  <depend>eigen</depend>
  <!-- global_planning이 export_global_planning으로 내보내는 CLCS Frenet 변환기 -->
  <depend>global_planning</depend>

  <!-- launch 전용: rviz:=true 및 선택적 clean-map 서버(detector_map_yaml:=...) -->
  <exec_depend>rviz2</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- test/의 시나리오 harness는 수동 rclpy 통합 테스트로 유지한다. -->
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
