<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>map_creator</name>
  <version>0.0.0</version>
  <description>Lap-transition obstacle_map pipeline: bakes pre-trigger static obstacles into the
    trajectory-generator map (blocked side painted to the wall via the shared local_planning
    side decision), regenerates the global raceline offline, and swaps it at a safe lap
    boundary through the global_planning reload service.</description>
  <maintainer email="haejun@example.com">haejun</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>f110_msgs</depend>
  <depend>local_planning</depend>
  <depend>libopencv-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>nlohmann-json-dev</depend>

  <!-- regeneration driver (subprocess): offline_trajectory_generator/regenerate_obstacle_map.py -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>static_obstacle_map</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
