<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lap_referee</name>
  <version>0.0.0</version>
  <description>
    Closed-loop rollout judge/recorder for f1tenth_gym_ros. Detects lap
    completion, collision, off-track, stuck, and timeout from ROS-observable
    signals and writes per-rollout metrics consumed by the DL speed optimizer.
  </description>
  <maintainer email="sungho@hanyang.ac.kr">parkm</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ackermann_msgs</depend>

  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
