# =================================================================================================
# Terminator config for the REAL car, global-line driving (NO local_planning).
# Launch it with:  ~/2026_IFAC/real/open_real.sh   (it substitutes @REALDIR@ and runs terminator).
#
# Layout `f1real` = one maximised window, 6 panes (LAUNCH_FULLSTACK.md §3 order minus T4):
#   LEFT  column : 1 bringup (f1tenth_stack) · 2 mcl · 3 global_planning
#   RIGHT column : 4 state_machine · 5 f1tenth_control (/drive) · 6 RViz + rosbag (Jetson)
# All panes run real/run_real.sh <role>, which SSHes into the Jetson ($F1_HOST,
# default miru@10.1.1.1), sources ROS 2 Jazzy + the right workspace, waits briefly for upstream
# nodes, launches, and drops to a REMOTE shell on Ctrl-C. Pane 6 uses ssh -X (RViz X-forward)
# and also starts `ros2 bag record -a` in PAUSED state (resume via /rosbag2_recorder/resume).
#
# state_machine without local_planning never leaves GLOBAL, so /local_waypoints is just the
# global line relayed. Initial pose: RViz 2D Pose Estimate (pane 6) after the car is placed.
# =================================================================================================
[global_config]
  suppress_multiple_term_dialog = True
  title_transmit_bg_color = "#2e3436"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
    show_titlebar = True
    cursor_blink = False
    background_darkness = 0.95
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
  [[f1real]]
    [[[window0]]]
      type = Window
      parent = ""
      maximised = True
      title = f1real — 실차 글로벌 주행 · 6 nodes (local_planning 없음 · ROS 2 Jazzy)
    [[[hbox]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[lcol]]]
      type = VPaned
      parent = hbox
      order = 0
      ratio = 0.25
    [[[t_bringup]]]
      type = Terminal
      parent = lcol
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh bringup
      title = 1 · bringup · f1tenth_stack (VESC/lidar/joy/mux)
    [[[lcolb]]]
      type = VPaned
      parent = lcol
      order = 1
      ratio = 0.34
    [[[t_mcl]]]
      type = Terminal
      parent = lcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh mcl
      title = 2 · localization · kinematic_localization
    [[[t_glob]]]
      type = Terminal
      parent = lcolb
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh global
      title = 3 · global_planning · wpnts + frenet_odom
    [[[rcol]]]
      type = VPaned
      parent = hbox
      order = 1
      ratio = 0.25
    [[[t_state]]]
      type = Terminal
      parent = rcol
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh state
      title = 4 · state_machine · /state + /local_waypoints
    [[[rcolb]]]
      type = VPaned
      parent = rcol
      order = 1
      ratio = 0.5
    [[[t_ctrl]]]
      type = Terminal
      parent = rcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh control
      title = 5 · f1tenth_control · /drive (마지막)
    [[[t_rviz]]]
      type = Terminal
      parent = rcolb
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh rviz
      title = 6 · RViz (젯슨 X-forward) + rosbag (PAUSED 시작)
[plugins]
