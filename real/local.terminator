# =================================================================================================
# Terminator config for the REAL car, FULL stack (local_planning + obstacle_detector included).
# Launch it with:  ~/2026_IFAC/real/local.sh   (it substitutes @REALDIR@ and runs terminator).
#
# Layout `f1real_local` = one maximised window, 7 panes (LAUNCH_FULLSTACK.md §3 full order):
#   LEFT  column : 1 bringup (f1tenth_stack) · 2 mcl · 3 global_planning · 4 local_planning
#   RIGHT column : 5 state_machine · 6 f1tenth_control (/drive) · 7 RViz + rosbag (Jetson)
# All panes run real/run_real.sh <role>, which SSHes into the Jetson ($F1_HOST,
# default miru@10.1.1.3), sources ROS 2 Jazzy + the right workspace, waits briefly for upstream
# nodes, launches, and drops to a REMOTE shell on Ctrl-C. Pane 7 uses ssh -X (RViz X-forward)
# and also starts `ros2 bag record -a` in PAUSED state (resume via /rosbag2_recorder/resume).
# Pane 4 runs local_planning with simulator:=false (obstacle_detector included by default).
# ⚠️ title 값에 쉼표(,)를 넣으면 terminator가 리스트로 파싱해 크래시한다 — 쉼표 금지.
# =================================================================================================
[global_config]
  suppress_multiple_term_dialog = True
  title_transmit_bg_color = "#2e3436"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
    show_titlebar = True
    cursor_blink = False
    background_darkness = 0.95
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
  [[f1real_local]]
    [[[window0]]]
      type = Window
      parent = ""
      maximised = True
      title = f1real_local — 실차 풀스택 · 7 nodes (local_planning 포함 · ROS 2 Jazzy)
    [[[hbox]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[lcol]]]
      type = VPaned
      parent = hbox
      order = 0
      ratio = 0.25
    [[[t_bringup]]]
      type = Terminal
      parent = lcol
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh bringup
      title = 1 · bringup · f1tenth_stack (VESC/lidar/joy/mux)
    [[[lcolb]]]
      type = VPaned
      parent = lcol
      order = 1
      ratio = 0.34
    [[[t_mcl]]]
      type = Terminal
      parent = lcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh mcl
      title = 2 · mcl · particle_filter_cpp (mod:=real)
    [[[lcolc]]]
      type = VPaned
      parent = lcolb
      order = 1
      ratio = 0.5
    [[[t_glob]]]
      type = Terminal
      parent = lcolc
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh global
      title = 3 · global_planning · wpnts + frenet_odom
    [[[t_local]]]
      type = Terminal
      parent = lcolc
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh local
      title = 4 · local_planning + obstacle_detector · /avoid_waypoints
    [[[rcol]]]
      type = VPaned
      parent = hbox
      order = 1
      ratio = 0.25
    [[[t_state]]]
      type = Terminal
      parent = rcol
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh state
      title = 5 · state_machine · /state + /local_waypoints
    [[[rcolb]]]
      type = VPaned
      parent = rcol
      order = 1
      ratio = 0.5
    [[[t_ctrl]]]
      type = Terminal
      parent = rcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh control
      title = 6 · f1tenth_control · /drive (마지막)
    [[[t_rviz]]]
      type = Terminal
      parent = rcolb
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh rviz
      title = 7 · RViz (젯슨 X-forward) + rosbag (PAUSED 시작)
[plugins]
