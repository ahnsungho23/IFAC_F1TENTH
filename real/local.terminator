# =================================================================================================
# Terminator config for the REAL car, FULL stack (local_planning + obstacle_detector included).
# Launch it with:  ~/2026_IFAC/real/local.sh   (it substitutes @REALDIR@ and runs terminator).
#
# Layout `f1real_local` = one maximised window, 8 panes (실차 실행 순서):
#   LEFT  column : 1 bringup(시각 동기화 → sudo jetson_clocks && f110) · 8 foxglove_bridge
#                  2 ping 192.168.0.10 · 3 kinematic_localization · 4 global_planning
#   🔑 8번을 1번 아래에 붙인 이유: 둘 다 기동 후 조용해지는 인프라 패널이라, 주행 중
#      계속 봐야 하는 5~7 번(플래너·상태·제어)의 높이를 안 깎는다.
#   RIGHT column : 5 local_planning(+obstacle_detector) · 6 state_machine · 7 f1tenth_control
#
# 모든 패널이 real/run_real.sh <role> 을 돌린다. 그 스크립트는 $F1_HOST(기본 miru@10.1.1.1)로
# ssh 해서 **대화형 zsh(zsh -ic)** 안에서 명령을 실행한다 — 젯슨 ~/.zshrc 의 `f110`·`sc`
# alias 가 비대화형 ssh 로는 안 풀리기 때문이다. ROS_DOMAIN_ID=70 은 rc 를 읽은 뒤 export 해서
# 젯슨 rc 값을 이긴다. 각 패널은 상류 노드를 잠깐 기다린 뒤 기동하고, Ctrl-C 하면 원격 셸로
# 떨어져 창이 살아 있다.
#
# ⚠️ 2 번 패널은 계속 흐르는 게 정상이다. 응답이 끊기면 라이다 **이더넷 링크**가 죽은
#    것이고, ping 은 되는데 /scan 만 멈추면 **라이다 본체/드라이버**다. 이 둘을 실시간으로
#    가르려고 넣은 창이다 (2026-08-25 백: 충돌 1.3s 뒤 Not Connected, 끝까지 미복구).
#    real/lidar_link_watch.sh 가 **기동 시 1회만** 점검한다 — "Destination Host
#    Unreachable" 이면 usbc_power.sh cycle --force 로 허브를 재부착하고 재확인한 뒤,
#    그 다음부터는 ping 만 흘린다(자동 복구 없음).
#    🔴 주행 중 자동 복구를 안 하는 이유: 같은 허브에 조이스틱이 물려 있어 사이클을
#       돌리면 /joy 가 죽는다 = 조이스틱 E-stop 을 못 쓴다.
# ⚠️ rosbag 녹화 패널은 이 레이아웃에 없다 — 젯슨에서 `f1rec` alias 로 따로 돌린다.
# ⚠️ 시각화는 8번(foxglove_bridge)이다. 본체 PC 브라우저에서 app.foxglove.dev ->
#    Open connection -> ws://10.1.1.1:8765. 초기 포즈도 여기서 2D Pose Estimate 로 찍는다
#    (브릿지가 /initialpose 만 발행 허용하도록 좁혀져 있다).
#    RViz 가 필요하면 여전히 `run_real.sh rviz` / `rvizlocal` 이 남아 있다.
# ⚠️ title 값에 쉼표(,)를 넣으면 terminator가 리스트로 파싱해 크래시한다 — 쉼표 금지.
# =================================================================================================
[global_config]
  suppress_multiple_term_dialog = True
  title_transmit_bg_color = "#2e3436"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
    show_titlebar = True
    cursor_blink = False
    background_darkness = 0.95
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
  [[f1real_local]]
    [[[window0]]]
      type = Window
      parent = ""
      maximised = True
      title = f1real_local — 실차 풀스택 · 8 panes · ROS_DOMAIN_ID=70 · miru@10.1.1.1
    [[[hbox]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[lcol]]]
      type = VPaned
      parent = hbox
      order = 0
      ratio = 0.42
    [[[lcola]]]
      type = VPaned
      parent = lcol
      order = 0
      ratio = 0.62
    [[[t_bringup]]]
      type = Terminal
      parent = lcola
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh bringup
      title = 1 · bringup · 시각 동기화 → sudo jetson_clocks && f110
    [[[t_fox]]]
      type = Terminal
      parent = lcola
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh foxglove
      title = 8 · foxglove_bridge · ws://10.1.1.1:8765 (브라우저로 접속)
    [[[lcolb]]]
      type = VPaned
      parent = lcol
      order = 1
      ratio = 0.22
    [[[t_ping]]]
      type = Terminal
      parent = lcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh ping
      title = 2 · 라이다 링크 · 기동 1회 점검 → 필요시 허브 재부착 · 이후 감시만
    [[[lcolc]]]
      type = VPaned
      parent = lcolb
      order = 1
      ratio = 0.5
    [[[t_mcl]]]
      type = Terminal
      parent = lcolc
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh mcl
      title = 3 · kinematic_localization · map_name:=map
    [[[t_glob]]]
      type = Terminal
      parent = lcolc
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh global
      title = 4 · global_planning · map_name:=map
    [[[rcol]]]
      type = VPaned
      parent = hbox
      order = 1
      ratio = 0.34
    [[[t_local]]]
      type = Terminal
      parent = rcol
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh local
      title = 5 · local_planning + obstacle_detector · /avoid_waypoints
    [[[rcolb]]]
      type = VPaned
      parent = rcol
      order = 1
      ratio = 0.5
    [[[t_state]]]
      type = Terminal
      parent = rcolb
      order = 0
      profile = default
      command = @REALDIR@/run_real.sh state
      title = 6 · state_machine · /state + /local_waypoints
    [[[t_ctrl]]]
      type = Terminal
      parent = rcolb
      order = 1
      profile = default
      command = @REALDIR@/run_real.sh control
      title = 7 · f1tenth_control · /drive (마지막)
[plugins]
