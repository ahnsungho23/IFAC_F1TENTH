# =================================================================================================
# Terminator config for the base 7-node simulation loop of this repo.
# Launch it with:  ~/2026_IFAC/sim/open_sim.sh   (it substitutes @SIMDIR@ and runs terminator).
#
# Layout `f1sim` = one maximised window, 7 panes (same order as the root CLAUDE.md run order):
#   LEFT  column : 1 f1sim (gym bridge + RViz) · 2 mcl · 3 global_planning · 4 local_planning
#   RIGHT column : 5 state_machine · 6 wpnt_publisher · 7 f1tenth_control (/drive)
# Each pane runs sim/run.sh <role>, which sources ROS 2 Jazzy + the right workspace, waits briefly
# for upstream nodes, launches, and drops to a shell on Ctrl-C. @SIMDIR@ is replaced at launch.
#
# For the opponent detect/overtake scenario use `open_sim.sh --opp` (9-pane layout) instead.
# =================================================================================================
[global_config]
  suppress_multiple_term_dialog = True
  title_transmit_bg_color = "#2e3436"
[keybindings]
[profiles]
  [[default]]
    scrollback_infinite = True
    show_titlebar = True
    cursor_blink = False
    background_darkness = 0.95
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
  [[f1sim]]
    [[[window0]]]
      type = Window
      parent = ""
      maximised = True
      title = f1sim base loop — 7 nodes (ROS 2 Jazzy)
    [[[hbox]]]
      type = HPaned
      parent = window0
      order = 0
      ratio = 0.5
    [[[lcol]]]
      type = VPaned
      parent = hbox
      order = 0
      ratio = 0.25
    [[[t_sim]]]
      type = Terminal
      parent = lcol
      order = 0
      profile = default
      command = @SIMDIR@/run.sh f1sim
      title = 1 · f1sim (gym bridge + RViz)
    [[[lcolb]]]
      type = VPaned
      parent = lcol
      order = 1
      ratio = 0.34
    [[[t_mcl]]]
      type = Terminal
      parent = lcolb
      order = 0
      profile = default
      command = @SIMDIR@/run.sh mcl
      title = 2 · mcl · particle_filter_cpp
    [[[lcolc]]]
      type = VPaned
      parent = lcolb
      order = 1
      ratio = 0.5
    [[[t_glob]]]
      type = Terminal
      parent = lcolc
      order = 0
      profile = default
      command = @SIMDIR@/run.sh global
      title = 3 · global_planning · wpnts + frenet_odom
    [[[t_local]]]
      type = Terminal
      parent = lcolc
      order = 1
      profile = default
      command = @SIMDIR@/run.sh local
      title = 4 · local_planning · obstacle avoidance
    [[[rcol]]]
      type = VPaned
      parent = hbox
      order = 1
      ratio = 0.34
    [[[t_state]]]
      type = Terminal
      parent = rcol
      order = 0
      profile = default
      command = @SIMDIR@/run.sh state
      title = 5 · state_machine · /state
    [[[rcolb]]]
      type = VPaned
      parent = rcol
      order = 1
      ratio = 0.5
    [[[t_wpnt]]]
      type = Terminal
      parent = rcolb
      order = 0
      profile = default
      command = @SIMDIR@/run.sh wpnt
      title = 6 · wpnt_publisher · /local_waypoints
    [[[t_ctrl]]]
      type = Terminal
      parent = rcolb
      order = 1
      profile = default
      command = @SIMDIR@/run.sh control
      title = 7 · f1tenth_control · /drive
[plugins]
